# Authentication Service Configuration
PORT=3001

# Generate a secure secret for local development using: openssl rand -hex 32
# Put the generated value into .env (which is strictly gitignored)
JWT_SECRET=generate_with_openssl_rand_hex_32

# Path to the SQLite database file
DB_PATH=./data/auth.db

# Comma-separated CORS and redirect allowlist for frontend applications
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3004
