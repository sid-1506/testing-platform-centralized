local.file_match "app_logs" {
  path_targets = [
    {
      __path__ = "/var/log/app/*.log",
      job      = "arch-applications",
    },
  ]
}

loki.process "app_logs_processor" {
  forward_to = [loki.write.local_loki.receiver]

  stage.json {
    expressions = {
      service     = "service",
      event       = "event",
      request_id  = "request_id",
      status_code = "status_code",
      instance_id = "instance_id",
    }
  }

  stage.labels {
    values = {
      service     = "service",
      event       = "event",
      status_code = "status_code",
      instance_id = "instance_id",
    }
  }
}

loki.source.file "app_logs_scraper" {
  targets       = local.file_match.app_logs.targets
  forward_to    = [loki.process.app_logs_processor.receiver]
  tail_from_end = false
}

loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
